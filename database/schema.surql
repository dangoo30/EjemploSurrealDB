DEFINE TABLE OVERWRITE user SCHEMAFULL;
DEFINE FIELD OVERWRITE username ON user TYPE string ASSERT string::len($value) >= 3;
DEFINE FIELD OVERWRITE email ON user TYPE string ASSERT string::is_email($value);
DEFINE FIELD OVERWRITE favoriteGenres ON user TYPE array<string> DEFAULT [];
DEFINE FIELD OVERWRITE createdAt ON user TYPE datetime DEFAULT time::now() READONLY;
DEFINE INDEX OVERWRITE userEmailUnique ON user FIELDS email UNIQUE;

DEFINE TABLE OVERWRITE song SCHEMAFULL;
DEFINE FIELD OVERWRITE title ON song TYPE string;
DEFINE FIELD OVERWRITE artist ON song TYPE string;
DEFINE FIELD OVERWRITE genre ON song TYPE string;
DEFINE FIELD OVERWRITE duration ON song TYPE duration;
DEFINE FIELD OVERWRITE metadata ON song TYPE object FLEXIBLE DEFAULT {};
DEFINE INDEX OVERWRITE songGenreIndex ON song FIELDS genre;

DEFINE TABLE OVERWRITE likes TYPE RELATION IN user OUT song SCHEMAFULL;
DEFINE FIELD OVERWRITE createdAt ON likes TYPE datetime DEFAULT time::now() READONLY;
DEFINE INDEX OVERWRITE likesUnique ON likes FIELDS in, out UNIQUE;

DEFINE TABLE OVERWRITE follows TYPE RELATION IN user OUT user SCHEMAFULL;
DEFINE FIELD OVERWRITE createdAt ON follows TYPE datetime DEFAULT time::now() READONLY;
DEFINE INDEX OVERWRITE followsUnique ON follows FIELDS in, out UNIQUE;
